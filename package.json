{
  "name": "olum-icons",
  "version": "0.4.0",
  "description": "A framework-agnostic collection of SVG icons as strings.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lucide": "./dist/lucide/index.js",
    "./heroicons/solid": "./dist/heroicons/solid/index.js",
    "./heroicons/outline": "./dist/heroicons/outline/index.js",
    "./fontawesome/solid": "./dist/fontawesome/solid/index.js",
    "./fontawesome/regular": "./dist/fontawesome/regular/index.js",
    "./fontawesome/brands": "./dist/fontawesome/brands/index.js",
    "./*.js": "./dist/*.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "attribution.md"
  ],
  "scripts": {
    "clean": "rm -rf svgs svgs_out dist",
    "clone": "./downloader.sh",
    "extract": "node scripts/extract-icons.cjs",
    "parse:lucide": "node scripts/parse-lucide.cjs",
    "parse:heroicons": "node scripts/parse-heroicons.cjs",
    "parse:fontawesome": "node scripts/parse-fontawesome.cjs",
    "parse:olum": "node scripts/parse-olum.cjs",
    "parse": "npm run parse:lucide && npm run parse:heroicons && npm run parse:fontawesome && npm run parse:olum",
    "optimize": "node scripts/optimize-icons.cjs",
    "build": "node scripts/build.cjs",
    "start": "node scripts/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olumjs/olum-icons.git"
  },
  "keywords": [
    "npm",
    "olum",
    "olumjs",
    "icons"
  ],
  "author": "Eissa Saber",
  "license": "(MIT AND CC-BY-4.0 AND ISC)",
  "bugs": {
    "url": "https://github.com/olumjs/olum-icons/issues"
  },
  "homepage": "https://github.com/olumjs/olum-icons#readme",
  "devDependencies": {
    "svgo": "^4.0.2"
  }
}
